generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERADMIN
  TEACHER
  STUDENT
  ASSISTANT
}

enum CourseLevel {
  BEGINNER
  ELEMENTERY
  PRE_INTERMEDIATE
  INTERMEDIATE
  ADVANCED
}

enum Answer {
  variantA
  variantB
  variantC
  variantD
}

model Users {
  id        Int      @id @default(autoincrement())
  full_name String
  phone     String   @unique
  password  String
  email     String?
  file      String?
  role      Role
  isPaid    Boolean  @default(false)
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  mentorProfile MentorProfile[]
  assistCourses Courses[]       @relation("CourseAssistent")

  @@map("users")
}

model MentorProfile {
  id          Int      @id @default(autoincrement())
  usersId     Int
  experiense  Float?
  job         String?
  web_link    String?
  description String?
  facebook    String?
  telegram    String?
  linkedin    String?
  instagram   String?
  github      String?
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  user    Users     @relation(fields: [usersId], references: [id], onDelete: Cascade)
  courses Courses[]

  @@map("mentor_profile")
}

model Categories {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  create_at DateTime  @default(now())
  update_at DateTime  @updatedAt
  courses   Courses[]

  @@map("categories")
}

model Courses {
  id           Int         @id @default(autoincrement())
  assistentId  Int?
  mentorId     Int
  name         String      @unique
  banner       String
  intro_video  String
  description  String
  prise        Decimal
  categoryId   Int
  level        CourseLevel
  isActive     Boolean     @default(true)
  create_at    DateTime    @default(now())
  update_at    DateTime    @updatedAt

  category      Categories    @relation(fields: [categoryId], references: [id])
  assistent     Users?        @relation("CourseAssistent", fields: [assistentId], references: [id])
  mentorProfile MentorProfile @relation(fields: [mentorId], references: [id])
  sections      Sections[]

  @@map("courses")
}

model Sections {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  courseId  Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  course  Courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lessons[]

  @@map("sections")
}

model Lessons {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  sectionId   Int
  description String
  file        String
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  section   Sections    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  materials Materials[]
  homeworks Homeworks[]
  exams     Exams[]

  @@map("lessons")
}

model Materials {
  id          Int          @id @default(autoincrement())
  lessonId    Int
  description String
  create_at   DateTime     @default(now())
  update_at   DateTime     @updatedAt

  lesson Lessons       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  files  MaterialFile[]

  @@map("materials")
}

model MaterialFile {
  id         Int      @id @default(autoincrement())
  materialId Int
  file       String
  create_at  DateTime @default(now())

  material Materials @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_files")
}

model Homeworks {
  id          Int      @id @default(autoincrement())
  lessonId    Int
  description String
  file        String?
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt

  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("homeworks")
}

model Exams {
  id       Int    @id @default(autoincrement())
  lessonId Int
  question String
  variantA String
  variantB String
  variantC String
  variantD String
  answer   Answer

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("exams")
}
